---
// Recordings live in public/recordings/ (site) and recordings/ (README GIFs).
interface Props {
  name: string;
  slug: string;
  description: string;
  note: string;
}
const { name, slug, description, note } = Astro.props;
---
<section class="win win-demo" aria-labelledby={`${slug}-demo-h`}>
  <p class="win-title" aria-hidden="true">kitty — {name} demo</p>
  <h2 class="sr-only" id={`${slug}-demo-h`}>{name} demo</h2>
  <video
    class="demo-video"
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    poster={`/recordings/${slug}-demo-poster.jpg`}
    aria-describedby={`${slug}-demo-desc`}
  >
    <source src={`/recordings/${slug}-demo.webm`} type="video/webm" />
    <source src={`/recordings/${slug}-demo.mp4`} type="video/mp4" />
  </video>
  <p class="sr-only" id={`${slug}-demo-desc`}>{description}</p>
  <p class="note demo-note">{note}</p>
</section>
