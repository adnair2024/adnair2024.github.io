---
interface Props {
  id?: string;
  title: string;
  labelledby: string;
  class?: string;
  primary?: boolean;
  focused?: boolean;
}
const { id, title, labelledby, class: cls = '', primary = false, focused = false } = Astro.props;
---
<section
  id={id}
  class:list={['win', cls, { 'is-focused': focused }]}
  aria-labelledby={labelledby}
  data-primary={primary ? '' : undefined}
>
  <p class="win-title" aria-hidden="true">{title}</p>
  <slot />
</section>
