---
import '../styles/global.css';
import { SITE_URL, site } from '../data/site';
import TopBar from '../components/TopBar.astro';

interface Props { standalone?: boolean; title?: string; }
const { standalone = false, title = site.title } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const og = new URL('/og.png', SITE_URL).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ashwin Nair's site styled as a Hyprland desktop" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={og} />
    <script is:inline src="/enable-js.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <TopBar standalone={standalone} />
    <main id="main" class="desk">
      <slot />
    </main>
    <p class="sr-only" id="ws-announce" role="status" aria-live="polite"></p>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
